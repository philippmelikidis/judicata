{
  "description": "judicata: give every new session a short summary of the review ledger, and warn at the end of a turn when work under a contract is not reviewed and done",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/judicata.py\" hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/judicata.py\" hook stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
