{
  "description": "judicata: give every new session a short summary of the review ledger, and send judicata's reviewer back once when its answer does not match the schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/judicata.py\" hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/judicata.py\" hook subagent-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
